# Copie para .env e ajuste. Gere segredos com: openssl rand -base64 48

# Banco de dados
POSTGRES_USER=qrp
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=qrp

# Chave das sessões (obrigatória em produção; mudar desconecta todos)
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Administrador criado no primeiro start (troca de senha obrigatória no 1º login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-tambem

# true quando acessado via HTTPS (NPM com certificado). Use false só para testes em http.
COOKIE_SECURE=true

# Onde publicar a porta no host
APP_BIND=127.0.0.1
APP_PORT=8000

# Opcionais
APP_NAME=QRP Viewer
SESSION_MAX_AGE=28800
MAX_UPLOAD_MB=50
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CONVERT_CONCURRENCY=2
